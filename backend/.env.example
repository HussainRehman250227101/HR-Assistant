# Django
SECRET_KEY=django-insecure-change-this-value-before-production
DJANGO_SETTINGS_MODULE=config.django.local
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIME_ZONE=UTC
LANGUAGE_CODE=en-us
SQLITE_DB_PATH=db.sqlite3
LOG_LEVEL=INFO

# Azure OpenAI GPT-5 mini (used in Module 06)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-your-key-locally
AZURE_OPENAI_CHAT_DEPLOYMENT=YOUR-GPT-5-MINI-DEPLOYMENT-NAME

# Azure GPT-5 mini API controls
AZURE_OPENAI_TIMEOUT_SECONDS=30
AZURE_OPENAI_MAX_RETRIES=2
AZURE_OPENAI_REASONING_EFFORT=low
AZURE_OPENAI_MAX_COMPLETION_TOKENS=2000

# Resume upload limits (maximum per file, batch count, and aggregate batch size)
RESUME_MAX_FILE_SIZE_MB=10
RESUME_MAX_BATCH_FILES=20
RESUME_MAX_BATCH_TOTAL_MB=50

# LangGraph local SQLite checkpoint database (not the Django application database)
LANGGRAPH_CHECKPOINT_DB_PATH=langgraph-checkpoints.sqlite3
LANGGRAPH_STRICT_MSGPACK=True

# Automatic resume scoring (Celery worker + beat). Each new, extracted resume is scored once, then waits
# for the recruiter's shortlist decision. Every scoring run is a live, billed Azure OpenAI call.
AUTO_SCORING_ENABLED=True
AUTO_SCORING_INTERVAL_SECONDS=120
AUTO_SCORING_BATCH_LIMIT=10
RESUME_EXTRACTION_WORKERS=4
# Empty = local SQLite queue file (no extra service). Production: redis://localhost:6379/0 (pip install redis)
CELERY_BROKER_URL=

# AI voice screening (Modules 10 and 16)
# browser   = (default) the ElevenLabs agent talks to the candidate in the HR app over WebRTC; no phone call.
#             Requires only ELEVENLABS_API_KEY and ELEVENLABS_AGENT_ID. Every Twilio setting below may stay empty.
# telephony = optional outbound phone calls through ElevenLabs' native Twilio integration (Module 10).
SCREENING_VOICE_MODE=browser
# A browser session that never connected (or whose page was closed) is released after this many minutes.
SCREENING_BROWSER_SESSION_TIMEOUT_MINUTES=15
VOICE_AI_PROVIDER=elevenlabs
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
# Server-side only; never exposed to the browser. Needs the ElevenLabs Agents ("Conversational AI") permission.
ELEVENLABS_API_KEY=
# Agent ID (agent_...) from the ElevenLabs Agents dashboard. Enable authentication on the agent.
ELEVENLABS_AGENT_ID=
VOICE_PROVIDER_TIMEOUT_SECONDS=15
# Both modes: attempts per screening, and the names the agent uses in its script
SCREENING_MAX_CALL_ATTEMPTS=3
SCREENING_ORGANIZATION_NAME=Example Company
SCREENING_HUMAN_CONTACT=recruiting@example.invalid

# Telephony mode only (SCREENING_VOICE_MODE=telephony). Optional and unused in browser mode.
# Import the Twilio number in ElevenLabs and copy its phone-number ID below.
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Calling safeguards for telephony mode (development: Pakistani numbers only)
SCREENING_ALLOWED_DIAL_PREFIXES=+92
SCREENING_RETRY_INTERVAL_MINUTES=120
SCREENING_CALL_TIMEZONE=Asia/Karachi
SCREENING_CALL_WINDOW_START_HOUR=9
SCREENING_CALL_WINDOW_END_HOUR=19

# Privacy: closed candidates older than this are erased by `manage.py apply_retention_policy`
CANDIDATE_RETENTION_DAYS=365

# JWT lifetimes in minutes (local default 10 days; production.py defaults to 15 min access / 12 h refresh)
# JWT_ACCESS_TOKEN_MINUTES=15
# JWT_REFRESH_TOKEN_MINUTES=720
# Production behind a TLS-terminating proxy:
# USE_X_FORWARDED_PROTO=True

# Interview scheduling (internal availability calendar)
SCHEDULING_MIN_NOTICE_HOURS=12
SCHEDULING_SLOT_STEP_MINUTES=30
SCHEDULING_MAX_PROPOSED_SLOTS=6
# Agent 3 sends the invitation automatically after HR approves the screening (set false for a manual flow).
INTERVIEW_AUTO_SCHEDULING_ENABLED=true
# Time zone assumed when the candidate does not state one, and the default interview length.
SCHEDULING_DEFAULT_TIMEZONE=Asia/Karachi
SCHEDULING_DEFAULT_DURATION_MINUTES=45
# HR declines send a friendly rejection email, then the candidate's resume and personal data are erased (name kept).
REJECTION_AUTO_ENABLED=true
REJECTION_MAX_EMAIL_ATTEMPTS=5

# Local email is console-only by default
# Dev: django.core.mail.backends.filebased.EmailBackend saves every email under backend/sent-emails/ (the console
# backend prints in whichever process sends it, e.g. the hidden Celery worker). Real delivery: ...smtp.EmailBackend + EMAIL_HOST*.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.invalid
EMAIL_TIMEOUT=10
# Module 13 invitation emails (use django.core.mail.backends.smtp.EmailBackend + EMAIL_HOST* for real delivery)
INVITATION_RESCHEDULE_CONTACT=recruiting@example.invalid
INVITATION_MESSAGE_ID_DOMAIN=hr-assistant.local
