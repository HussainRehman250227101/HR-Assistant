# Django
SECRET_KEY=django-insecure-change-this-value-before-production
DJANGO_SETTINGS_MODULE=config.django.local
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIME_ZONE=UTC
LANGUAGE_CODE=en-us
SQLITE_DB_PATH=db.sqlite3
LOG_LEVEL=INFO

# Azure OpenAI GPT-5 mini (used in Module 06)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-your-key-locally
AZURE_OPENAI_CHAT_DEPLOYMENT=YOUR-GPT-5-MINI-DEPLOYMENT-NAME

# Azure GPT-5 mini API controls
AZURE_OPENAI_TIMEOUT_SECONDS=30
AZURE_OPENAI_MAX_RETRIES=2
AZURE_OPENAI_REASONING_EFFORT=low
AZURE_OPENAI_MAX_COMPLETION_TOKENS=2000

# Resume upload limits (maximum per file, batch count, and aggregate batch size)
RESUME_MAX_FILE_SIZE_MB=10
RESUME_MAX_BATCH_FILES=20
RESUME_MAX_BATCH_TOTAL_MB=50

# LangGraph local SQLite checkpoint database (not the Django application database)
LANGGRAPH_CHECKPOINT_DB_PATH=langgraph-checkpoints.sqlite3
LANGGRAPH_STRICT_MSGPACK=True

# Module 10 voice screening: ElevenLabs Conversational AI places calls through its native Twilio
# integration. Import the Twilio number in ElevenLabs and copy its phone-number ID below.
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VOICE_AI_PROVIDER=elevenlabs
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
VOICE_PROVIDER_TIMEOUT_SECONDS=15
# Calling safeguards (development: Pakistani numbers only)
SCREENING_ALLOWED_DIAL_PREFIXES=+92
SCREENING_MAX_CALL_ATTEMPTS=3
SCREENING_RETRY_INTERVAL_MINUTES=120
SCREENING_CALL_TIMEZONE=Asia/Karachi
SCREENING_CALL_WINDOW_START_HOUR=9
SCREENING_CALL_WINDOW_END_HOUR=19
SCREENING_ORGANIZATION_NAME=Example Company
SCREENING_HUMAN_CONTACT=recruiting@example.invalid

# Interview scheduling (internal availability calendar)
SCHEDULING_MIN_NOTICE_HOURS=12
SCHEDULING_SLOT_STEP_MINUTES=30
SCHEDULING_MAX_PROPOSED_SLOTS=6

# Local email is console-only by default
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.invalid
EMAIL_TIMEOUT=10
